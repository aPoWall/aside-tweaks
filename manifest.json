{
  "manifest_version": 3,
  "name": "Aside Tweaks",
  "version": "4.11.0",
  "description": "Palette (⇧⌘K) over tabs, history and bookmarks · own keymap over browser shortcuts · ⌘D moves a page into the bookmarks bar and back · dedupe · new tabs under the current one.",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "history",
    "favicon",
    "bookmarks",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "keys.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aside Tweaks",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "tw"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Открыть боковую панель твиков"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Палитра"
    },
    "favorite-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "MacCtrl+Shift+B"
      },
      "description": "Закладка ⇄ вкладка: в конец панели закладок и обратно наверх"
    },
    "pin-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "MacCtrl+D"
      },
      "description": "Закрепить / открепить вкладку"
    },
    "tidy-duplicates": {
      "description": "Закрыть дубликаты и пустые вкладки"
    },
    "tidy-up": {
      "description": "Свести всё разом: чистка, порядок, блоки"
    },
    "bookmark-tab": {
      "description": "В закладки без диалога (тогл)"
    }
  }
}
