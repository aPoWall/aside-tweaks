{
  "manifest_version": 3,
  "name": "Aside Tweaks",
  "version": "4.31.0",
  "description": "Aside-native Bookmarks and Pins, a fast palette, local Obsidian search and protected tab-review previews.",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "history",
    "favicon",
    "bookmarks",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "keys.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aside Tweaks",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "tw"
  },
  "commands": {
    "toggle-surface": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Открыть или закрыть панель твиков"
    },
    "open-panel": {
      "description": "Боковая панель твиков (клавиша задаётся вручную)"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Палитра"
    },
    "favorite-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+D"
      },
      "description": "Сохранить / убрать из Bookmarks: последняя строка, фокус остаётся"
    },
    "pin-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+D"
      },
      "description": "Закрепить / открепить вкладку"
    },
    "tidy-duplicates": {
      "description": "Review вкладок: что закроется и что останется"
    },
    "clean-duplicates": {
      "description": "Preview точных дублей и пустых вкладок перед закрытием"
    },
    "tidy-up": {
      "description": "Preview уборки: затем плоский список, свежие наверх, блоки"
    },
    "bookmark-tab": {
      "description": "Legacy: обычная закладка браузера без строки Aside Bookmarks"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "palette.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://openrouter.ai/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
