{
  "manifest_version": 3,
  "name": "Aside Tweaks",
  "version": "4.19.0",
  "description": "A review layer for Aside: product-aware tab families, protected cleanup previews and receipts, plus the palette, keymap, Obsidian and agent bridge.",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "history",
    "favicon",
    "bookmarks",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "keys.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aside Tweaks",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options.html",
  "omnibox": {
    "keyword": "tw"
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Открыть боковую панель твиков"
    },
    "open-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Палитра"
    },
    "favorite-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+D"
      },
      "description": "Закладка ⇄ вкладка: первой в панели, затем следующая открытая вкладка"
    },
    "pin-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+D"
      },
      "description": "Закрепить / открепить вкладку"
    },
    "tidy-duplicates": {
      "description": "Открыть review вкладок перед очисткой"
    },
    "tidy-up": {
      "description": "Review, затем чистка, порядок и блоки"
    },
    "bookmark-tab": {
      "description": "В закладки без диалога (тогл)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "palette.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://openrouter.ai/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
